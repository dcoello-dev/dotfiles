#!/usr/bin/env python3
"""histdb: query your shell history with metadata.

The shell only does a `printf >>` into var/history.tsv, which costs nothing. This
program imports those records into SQLite when you ask it something, then queries.
It uses only python3's standard library: there is no sqlite3 CLI on this machine,
but the module is there.

Usage:
  histdb last [n]             the latest commands with their metadata
  histdb here [n]             the ones from this directory
  histdb fails [n]            the ones that failed
  histdb slow [n]             the slowest
  histdb find <text> [n]      search by text
  histdb stats <command>      how many times, how many failures, how long
  histdb top [n]              the most used
  histdb runs <command> [n]   the latest runs of THAT exact command
  histdb pick [--here]        interactive picker; prints the chosen command
  histdb import               import only, no query
"""
import os, shutil, sqlite3, subprocess, sys, time

HOME = os.path.expanduser("~")
LAB  = os.environ.get("LAB_HOME", os.path.join(HOME, "shell-lab"))
VAR  = os.path.join(LAB, "var")
TSV  = os.environ.get("LAB_HISTFILE", os.path.join(VAR, "history.tsv"))
DB   = os.path.join(VAR, "history.db")

SCHEMA = """
CREATE TABLE IF NOT EXISTS history (
  id       INTEGER PRIMARY KEY,
  ts       INTEGER NOT NULL,
  status   INTEGER NOT NULL,
  dur_us   INTEGER NOT NULL,
  cwd      TEXT    NOT NULL,
  session  TEXT    NOT NULL,
  cmd      TEXT    NOT NULL
);
CREATE INDEX IF NOT EXISTS i_cmd ON history(cmd);
CREATE INDEX IF NOT EXISTS i_cwd ON history(cwd);
CREATE INDEX IF NOT EXISTS i_ts  ON history(ts);
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
"""

G, R, D, O, X = "\033[38;5;118m", "\033[38;5;197m", "\033[38;5;66m", "\033[38;5;208m", "\033[0m"


def unescape(s):
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s):
            c = s[i + 1]
            out.append({"t": "\t", "n": "\n", "\\": "\\"}.get(c, "\\" + c))
            i += 2
        else:
            out.append(s[i]); i += 1
    return "".join(out)


def db():
    os.makedirs(VAR, exist_ok=True)
    c = sqlite3.connect(DB)
    c.executescript(SCHEMA)
    return c


def imported_offset(c):
    r = c.execute("SELECT v FROM meta WHERE k='offset'").fetchone()
    return int(r[0]) if r else 0


def do_import(c, verbose=False):
    """Incremental: remembers the file offset and only reads what is new."""
    if not os.path.exists(TSV):
        return 0
    off = imported_offset(c)
    size = os.path.getsize(TSV)
    if size < off:                      # file was truncated: reimport everything
        c.execute("DELETE FROM history"); off = 0
    if size == off:
        return 0
    n = 0
    with open(TSV, "r", encoding="utf8", errors="replace") as f:
        f.seek(off)
        rows = []
        for line in f:
            if not line.endswith("\n"):          # half-written line
                size = f.tell() - len(line.encode("utf8"))
                break
            p = line.rstrip("\n").split("\t", 5)
            if len(p) != 6:
                continue
            try:
                rows.append((int(p[0]), int(p[1]), int(p[2]), p[3], p[4], unescape(p[5])))
            except ValueError:
                continue
        if rows:
            c.executemany("INSERT INTO history(ts,status,dur_us,cwd,session,cmd) "
                          "VALUES (?,?,?,?,?,?)", rows)
            n = len(rows)
    c.execute("INSERT OR REPLACE INTO meta(k,v) VALUES ('offset',?)", (str(size),))
    c.commit()
    if verbose:
        print(f"imported {n} records")
    return n


def fmt_dur(us):
    if us <= 0:              return ""
    if us < 1000:            return f"{us}us"
    if us < 1_000_000:       return f"{us/1000:.0f}ms"
    if us < 60_000_000:      return f"{us/1_000_000:.1f}s"
    return f"{us//60_000_000}m{(us%60_000_000)//1_000_000:02d}s"


def ago(ts):
    d = int(time.time()) - ts
    if d < 60:       return f"{d}s"
    if d < 3600:     return f"{d//60}m"
    if d < 86400:    return f"{d//3600}h"
    if d < 2_592_000: return f"{d//86400}d"
    return f"{d//2_592_000}mo"


def short(p):
    return p.replace(HOME, "~", 1) if p.startswith(HOME) else p


def show(rows):
    if not rows:
        print("  (nothing)"); return
    for ts, st, dur, cwd, cmd in rows:
        when = time.strftime("%d/%m %H:%M", time.localtime(ts))
        mark = f"{G}ok{X}" if st == 0 else f"{R}{st:>2}{X}"
        print(f"  {D}{when}{X}  {mark}  {D}{fmt_dur(dur):>6}{X}  {O}{short(cwd):<26}{X}  {cmd}")


def rollup(c, here=False, only_failed=False, limit=5000):
    """One row per command, with its accumulated metadata."""
    where, args = [], []
    if here:
        where.append("cwd = ?"); args.append(os.getcwd())
    if only_failed:
        where.append("status != 0")
    w = ("WHERE " + " AND ".join(where)) if where else ""
    q = f"""
      SELECT cmd,
             COUNT(*)         AS runs,
             SUM(status != 0) AS failures,
             MAX(ts)          AS last_ts,
             AVG(dur_us)      AS mean_us,
             MAX(id)          AS last_id
      FROM history {w}
      GROUP BY cmd
      ORDER BY MAX(id) DESC
      LIMIT ?"""
    rows = c.execute(q, (*args, limit)).fetchall()
    # the exit status of each command's LAST run
    statuses = dict(c.execute("SELECT id, status FROM history").fetchall())
    out = []
    for cmd, runs, failures, last_ts, mean_us, last_id in rows:
        out.append((cmd, runs, failures or 0, last_ts, int(mean_us or 0),
                    statuses.get(last_id, 0)))
    return out


def rollup_line(f):
    cmd, runs, failures, last_ts, mean_us, last_status = f
    mark = f"{G}  ok{X}" if last_status == 0 else f"{R}{last_status:>4}{X}"
    count = f"{runs:>4}x"
    count += f" {R}({failures}!){X}" if failures else "      "
    return (f"{mark}  {D}{count}{X}  {D}{fmt_dur(mean_us):>7}{X}  "
            f"{D}{ago(last_ts):>5}{X}\t{cmd}")


def cmd_runs(c, cmd, n=12):
    rows = c.execute("SELECT ts,status,dur_us,cwd FROM history WHERE cmd = ? "
                     "ORDER BY id DESC LIMIT ?", (cmd, n)).fetchall()
    if not rows:
        print("  no runs recorded"); return
    tot, bad, lo, avg, hi = c.execute(
        "SELECT COUNT(*), SUM(status!=0), MIN(dur_us), AVG(dur_us), MAX(dur_us) "
        "FROM history WHERE cmd = ?", (cmd,)).fetchone()
    print(f"  {O}{cmd}{X}")
    print(f"  {tot} runs, {bad or 0} failed   "
          f"min {fmt_dur(lo or 0)}  mean {fmt_dur(int(avg or 0))}  max {fmt_dur(hi or 0)}")
    print()
    for ts, st, dur, cwd in rows:
        mark = f"{G}ok{X}" if st == 0 else f"{R}{st:>2}{X}"
        print(f"  {D}{time.strftime('%d/%m %H:%M', time.localtime(ts))}{X}  {mark}  "
              f"{D}{fmt_dur(dur):>7}{X}  {O}{short(cwd)}{X}")


def cmd_pick(c, here=False, only_failed=False):
    rows = rollup(c, here, only_failed)
    if not rows:
        return 1
    lines = [rollup_line(f) for f in rows]
    me = os.path.abspath(__file__)
    title = "history"
    if here:        title += " (here)"
    if only_failed: title += " (failed)"
    if shutil.which("fzf"):
        r = subprocess.run(
            ["fzf", "--ansi", "--delimiter=\t", "--with-nth=1,2",
             # no --height: fzf then uses the alternate screen and restores it on
             # exit. With a fixed height it draws inline and fights the custom
             # editor, which is repainting the line right there.
             "--reverse", "--border",
             f"--prompt={title}> ",
             "--header=enter picks   ctrl-c cancels",
             f"--preview={me} runs {{2}}",
             "--preview-window=down:12:wrap:border-top"],
            input="\n".join(lines), text=True,
            stdout=subprocess.PIPE)   # stderr NOT captured: fzf draws there and on /dev/tty
        if r.returncode != 0 or not r.stdout.strip():
            return 1
        chosen = r.stdout.rstrip("\n").split("\t", 1)
        print(chosen[1] if len(chosen) > 1 else chosen[0])
        return 0
    # no fzf: numbered list
    for i, l in enumerate(lines[:40], 1):
        print(f"  {i:>3}) {l.replace(chr(9), '  ')}", file=sys.stderr)
    try:
        sel = int(input("number: "))
    except (ValueError, EOFError, KeyboardInterrupt):
        return 1
    if 1 <= sel <= len(rows):
        print(rows[sel - 1][0]); return 0
    return 1


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "last"
    c = db()
    do_import(c, verbose=(cmd == "import"))
    if cmd == "import":
        return
    n, arg = 20, None
    if cmd in ("find", "stats", "runs"):
        if len(a) < 2:
            print(f"usage: histdb {cmd} <text>"); return
        arg = a[1]
        if len(a) > 2:
            n = int(a[2])
    elif len(a) > 1 and a[1].isdigit():
        n = int(a[1])

    Q = "SELECT ts,status,dur_us,cwd,cmd FROM history"
    if cmd == "last":
        show(c.execute(f"{Q} ORDER BY id DESC LIMIT ?", (n,)).fetchall())
    elif cmd == "here":
        show(c.execute(f"{Q} WHERE cwd=? ORDER BY id DESC LIMIT ?", (os.getcwd(), n)).fetchall())
    elif cmd == "fails":
        show(c.execute(f"{Q} WHERE status!=0 ORDER BY id DESC LIMIT ?", (n,)).fetchall())
    elif cmd == "slow":
        show(c.execute(f"{Q} ORDER BY dur_us DESC LIMIT ?", (n,)).fetchall())
    elif cmd == "find":
        show(c.execute(f"{Q} WHERE cmd LIKE ? ORDER BY id DESC LIMIT ?", (f"%{arg}%", n)).fetchall())
    elif cmd == "top":
        for runs, bad, cmd_, mean in c.execute(
                "SELECT COUNT(*), SUM(status!=0), cmd, AVG(dur_us) FROM history "
                "GROUP BY cmd ORDER BY COUNT(*) DESC LIMIT ?", (n,)):
            print(f"  {runs:>4}x  {R}{bad or 0} failed{X}  {D}{fmt_dur(int(mean or 0)):>6}{X}  {cmd_}")
    elif cmd == "runs":
        cmd_runs(c, arg, n)
    elif cmd == "pick":
        sys.exit(cmd_pick(c, here=("--here" in a), only_failed=("--fails" in a)))
    elif cmd == "stats":
        tot, bad, lo, avg, hi = c.execute(
            "SELECT COUNT(*), SUM(status!=0), MIN(dur_us), AVG(dur_us), MAX(dur_us) "
            "FROM history WHERE cmd LIKE ?", (f"{arg}%",)).fetchone()
        if not tot:
            print(f"  never ran anything starting with {arg!r}"); return
        print(f"  {arg!r}: {tot} runs, {bad or 0} failed")
        print(f"     duration  min {fmt_dur(lo or 0)}  mean {fmt_dur(int(avg or 0))}  max {fmt_dur(hi or 0)}")
        print("     directories you use it in:")
        for cwd, k in c.execute("SELECT cwd, COUNT(*) FROM history WHERE cmd LIKE ? "
                                "GROUP BY cwd ORDER BY COUNT(*) DESC LIMIT 5", (f"{arg}%",)):
            print(f"       {k:>4}x  {short(cwd)}")
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
